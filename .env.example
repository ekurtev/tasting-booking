# Copy to .env (never commit .env). Easiest: ./scripts/gen-env.sh — it copies this file and
# replaces every __GENERATE__ with a fresh random secret without printing it.

POSTGRES_DB=tasting
POSTGRES_USER=tasting
POSTGRES_PASSWORD=__GENERATE__

# Public base URL of the site (production: https://vkus.eliankurtev.com)
APP_URL=http://localhost:3000

# First (and only) admin account, created on first start when no admin exists yet.
# Changing these later does NOT change the existing admin; to set a new password run
#   docker compose exec app node scripts/migrate.mjs --reset-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__GENERATE__

# Phone shown to customers when online cancellation is no longer possible (< 24 h before start)
CONTACT_PHONE="+359 000 000 000"

# Local only: host interface/port for the app (production override removes the port)
APP_BIND=127.0.0.1
APP_PORT=3000
